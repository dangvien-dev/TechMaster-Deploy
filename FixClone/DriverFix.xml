<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Fix Driver — TechMaster Deploy" Width="1120" Height="820" MinWidth="740" MinHeight="500" WindowStartupLocation="CenterScreen" Background="#F3F6FB" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
<Window.Resources>
 <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style TargetType="Button"><Setter Property="Background" Value="#224775"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#E7EFF9"/><Setter Property="Foreground" Value="#10223F"/></Style>
 <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="BorderBrush" Value="#DFE7F1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
 <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,5,0,8"/></Style>
</Window.Resources>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Border Background="#10223F" Padding="24,18"><StackPanel><TextBlock Text="Fix Driver" Foreground="White" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Quét → mở Catalog → tự tải CAB → chọn gói để cài → quét lại thiết bị con" Foreground="#BED2E9" Margin="0,6,0,0"/></StackPanel></Border>
 <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="22">
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="MachineInfo" Text="Đang đọc thông tin máy…" Foreground="#526880" Margin="0,0,0,12"/>
   <WrapPanel x:Name="ScanControls"><Button x:Name="Scan" Content="Quét lại"/><Button x:Name="Rescan" Content="Dò phần cứng và quét" Style="{StaticResource Secondary}"/><Button x:Name="CopyIds" Content="Copy Hardware ID" Style="{StaticResource Secondary}"/></WrapPanel>
   <DataGrid x:Name="Devices" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" Height="190" BorderBrush="#DFE7F1" Background="White" Margin="0,6,0,10" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="Thiết bị" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Code" Binding="{Binding ErrorCode}" Width="55"/><DataGridTextColumn Header="Mô tả" Binding="{Binding Description}" Width="270"/></DataGrid.Columns></DataGrid>
   <TextBox x:Name="DeviceDetails" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" FontFamily="Consolas" FontSize="12" MinHeight="75" MaxHeight="160" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="#F3F6FB" Padding="10"/>
   <ItemsControl x:Name="CatalogLinks" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Margin="0,0,0,10"><Hyperlink NavigateUri="{Binding Url}"><Run Text="{Binding Query}"/></Hyperlink></TextBlock></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Cài từ nguồn do kỹ thuật viên chọn" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Không tải driver tự động. CAB được giải nén tạm; INF được cài bằng pnputil. Windows quyết định gói phù hợp và kiểm tra chữ ký." Foreground="#526880" Margin="0,7,0,14"/>
   <WrapPanel x:Name="InstallControls"><Button x:Name="InstallCab" Content="Chọn CAB và cài…"/><Button x:Name="InstallFolder" Content="Chọn thư mục INF và cài…"/><Button x:Name="Repository" Content="Cài từ kho USB / NAS…" Style="{StaticResource Secondary}"/></WrapPanel>
   <TextBlock Text="Kho cục bộ: đối chiếu Hardware ID trong INF, theo thứ tự profile nếu khớp; tối đa 4 vòng. Sau mỗi vòng quét lại để phát hiện thiết bị con. Không tự khởi động lại máy." Foreground="#526880"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Gợi ý theo dòng máy (tuỳ chọn)" FontSize="18" FontWeight="SemiBold"/>
   <TextBox x:Name="ProfileDetails" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MaxHeight="235" BorderThickness="0" Background="White" Margin="0,10,0,12"/>
   <WrapPanel x:Name="ProfileControls"><Button x:Name="OpenProfiles" Content="Mở thư mục JSON profile" Style="{StaticResource Secondary}"/><Button x:Name="Disable" Content="Disable thiết bị đang chọn…" Style="{StaticResource Secondary}" IsEnabled="False"/></WrapPanel>
   <TextBlock Text="Disable chỉ dành cho thiết bị con có Hardware ID khớp profile, sau khi đã thử driver phù hợp. Không tự disable theo tên hay tự thay đổi BIOS." Foreground="#526880"/>
   <TextBlock Text="Tinh chỉnh nguồn theo profile (chọn mục cần áp dụng)" FontWeight="SemiBold" Margin="0,18,0,8"/>
   <StackPanel x:Name="PowerChoices"/>
   <Button x:Name="ApplyPower" Content="Xem và xác nhận chỉnh nguồn…" HorizontalAlignment="Left" Style="{StaticResource Secondary}" IsEnabled="False"/>
  </StackPanel></Border>
 </StackPanel></ScrollViewer>
 <Border Grid.Row="2" Background="White" BorderBrush="#DFE7F1" BorderThickness="0,1,0,0" Padding="20,12"><StackPanel><ProgressBar x:Name="Busy" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,10"/><TextBlock x:Name="Status" Text="Sẵn sàng" Margin="0,0,0,10" Foreground="#526880"/><WrapPanel><Button x:Name="Report" Content="Xuất báo cáo HTML"/><Button x:Name="OpenLogs" Content="Mở nhật ký" Style="{StaticResource Secondary}"/><Button x:Name="Help" Content="Hướng dẫn test" Style="{StaticResource Secondary}"/><Button x:Name="Cancel" Content="Dừng sau gói đang cài" Style="{StaticResource Secondary}" Visibility="Collapsed"/><Button x:Name="Close" Content="Đóng" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
</Grid></Window>
