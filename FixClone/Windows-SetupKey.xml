<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Key cài đặt chung Windows" Width="820" Height="620" MinWidth="650" MinHeight="430" WindowStartupLocation="CenterScreen" Background="#F3F6FB" Foreground="#10223F" FontFamily="Segoe UI" FontSize="14">
<Window.Resources><Style TargetType="Button"><Setter Property="Background" Value="#214674"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="MinHeight" Value="38"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter x:Name="ButtonContent" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border x:Name="FocusOutline" BorderBrush="Transparent" BorderThickness="2" CornerRadius="8" IsHitTestVisible="False"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusOutline" Property="BorderBrush" Value="#38BDF8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style><Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#E7EEF8"/><Setter Property="Foreground" Value="#183655"/></Style></Window.Resources>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="#10223F" Padding="24"><StackPanel><TextBlock Text="Key cài đặt chung Windows" Foreground="White" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Chỉ dọn key chung Pro …3V66T đã xác minh và chưa kích hoạt. Windows đang kích hoạt và các key khác được giữ nguyên." Foreground="#BED2E9" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border><Border Grid.Row="1" Background="White" CornerRadius="12" Margin="22" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="3V66T là key cài đặt chung, không phải key dùng thử hay key bản quyền riêng. Sau khi dọn, nhập key bản quyền của máy khách tại Windows Settings → System → Activation." TextWrapping="Wrap" Margin="0,0,0,16"/><TextBlock x:Name="Inventory" Text="Bấm Kiểm tra lại để đọc thông tin Windows." TextWrapping="Wrap"/><Border Tag="Notice" Margin="0,18,0,0"><TextBlock x:Name="Status" TextWrapping="Wrap" Foreground="#526880" Margin="0"/></Border></StackPanel></ScrollViewer></Border><WrapPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="22,0,22,18"><Button x:Name="Refresh" Style="{StaticResource Secondary}" Content="Kiểm tra lại" Padding="16,10" Margin="0,0,10,0"/><Button x:Name="Restore" Style="{StaticResource Secondary}" Content="Hoàn tác key chung" Padding="16,10" Margin="0,0,10,0" IsEnabled="False"/><Button x:Name="Close" Style="{StaticResource Secondary}" Content="Đóng" Padding="16,10" Margin="0,0,10,0"/><Button x:Name="Clean" Content="Dọn key chung" Padding="16,10" IsEnabled="False"/></WrapPanel></Grid></Window>
