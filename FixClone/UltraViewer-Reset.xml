<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Định danh UltraViewer" Width="760" Height="570" MinWidth="640" MinHeight="440" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14" Background="#F3F6FB" Foreground="#10223F" UseLayoutRounding="True">
<Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="Định danh UltraViewer" FontWeight="SemiBold" FontSize="24" Margin="0,0,0,20"/>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,4,0">
 <TextBlock Text="Dành cho UltraViewer 6.6.133. Reset đúng UID và PreferID, giữ LastHR, MAC và MachineGuid. Có sao lưu để khôi phục hai giá trị cũ." TextWrapping="Wrap" Margin="0,0,0,16"/>
 <Border Tag="Notice"><TextBlock x:Name="Status" Text="Sẵn sàng. Chọn Sao lưu và reset ID khi cần tạo định danh mới cho máy này." TextWrapping="Wrap"/></Border>
 <Border CornerRadius="4" Tag="RoundedClip" Background="White" BorderThickness="0" Margin="0,16,0,12" Height="8"><ProgressBar x:Name="Progress" BorderThickness="0"/></Border>
 <Border x:Name="BackupPanel" Background="White" BorderBrush="#DFE7F1" BorderThickness="1" CornerRadius="8" Padding="12" Visibility="Collapsed"><StackPanel><TextBlock Text="Lịch sử trên máy này" FontWeight="SemiBold" Foreground="#526880" Margin="0,0,0,6"/><TextBlock x:Name="History" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBlock Text="Bản sao lưu" FontSize="12" Foreground="#526880"/><TextBlock x:Name="Backup" TextWrapping="Wrap" FontSize="12" Foreground="#526880"/></StackPanel></Border>
 <TextBlock Text="Reset sẽ ngắt UltraViewer. Thực hiện tại máy hoặc qua công cụ remote khác; mở UltraViewer và đợi kết nối để kiểm tra ID mới." Foreground="#526880" TextWrapping="Wrap" Margin="0,16,0,0"/>
</StackPanel></ScrollViewer>
<WrapPanel Grid.Row="2" Margin="0,18,0,0"><Button x:Name="Reset" Content="Sao lưu và reset ID" Padding="14,10" Margin="0,0,10,8"/><Button x:Name="Check" Content="Kiểm tra ID mới" Padding="14,10" Margin="0,0,10,8"/><Button x:Name="Restore" Content="Khôi phục…" Background="#E7EEF8" Foreground="#183655" Padding="14,10" Margin="0,0,10,8"/><Button x:Name="Close" Content="Đóng" Background="#E7EEF8" Foreground="#183655" Padding="14,10" Margin="0,0,10,8"/></WrapPanel>
</Grid></Window>
