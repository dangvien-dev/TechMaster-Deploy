<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Chia sẻ thư mục" Width="840" Height="800" MinWidth="640" MinHeight="460" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Background="#F3F6FB" Foreground="#10223F" UseLayoutRounding="True">
<Window.Resources>
 <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="36"/></Style>
 <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="BorderBrush" Value="#DFE7F1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
 <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
 <Style x:Key="Label" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#526880"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
</Window.Resources>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="#10223F" Padding="24,20"><StackPanel><TextBlock Text="Chia sẻ thư mục" FontSize="24" FontWeight="SemiBold" Foreground="White"/><TextBlock x:Name="Subtitle" Foreground="#BED2E9" Margin="0,8,0,0" Text="Chia sẻ thư mục trên máy này cho tài khoản scan / share / print trong mạng LAN."/></StackPanel></Border>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="22,18,22,8">
 <Border Tag="Notice" Margin="0,0,0,14"><TextBlock x:Name="Status" Text="Đang đọc thiết lập…"/></Border>
 <StackPanel x:Name="Choices">
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Thư mục" Style="{StaticResource Heading}"/>
   <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Tag="RoundedClip" CornerRadius="8" BorderBrush="#C7D5E5" BorderThickness="1" Background="White"><TextBox x:Name="FolderPath" IsReadOnly="True" BorderThickness="0" Padding="10,8" MinHeight="36" VerticalContentAlignment="Center" Background="#F8FAFD"/></Border><Button x:Name="Browse" Grid.Column="1" Content="Chọn thư mục…" Margin="10,0,0,0"/></Grid>
   <TextBlock x:Name="FolderNote" Style="{StaticResource Label}" Margin="0,0,0,12"/>
   <TextBlock Text="Tên chia sẻ" Style="{StaticResource Label}"/><Border Tag="RoundedClip" CornerRadius="8" BorderBrush="#C7D5E5" BorderThickness="1" Background="White"><TextBox x:Name="ShareName" BorderThickness="0" Padding="10,8" MinHeight="36" VerticalContentAlignment="Center"/></Border>
   <TextBlock x:Name="ShareHint" Style="{StaticResource Label}" Margin="0,6,0,0"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Phân quyền" Style="{StaticResource Heading}"/>
   <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="scan — máy photocopy / máy scan" FontWeight="SemiBold"/><TextBlock x:Name="AccessNoteScan" Style="{StaticResource Label}" Margin="0,2,0,0"/></StackPanel>
    <Border Grid.Column="2" Tag="RoundedClip" CornerRadius="8" BorderBrush="#C7D5E5" BorderThickness="1" Background="White" VerticalAlignment="Center"><ComboBox x:Name="AccessScan" BorderThickness="0"><ComboBoxItem Content="Không" Tag="None"/><ComboBoxItem Content="Chỉ đọc" Tag="Read"/><ComboBoxItem Content="Đọc &amp; ghi" Tag="Change"/></ComboBox></Border>
   </Grid>
   <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="share — người dùng mở thư mục" FontWeight="SemiBold"/><TextBlock x:Name="AccessNoteShare" Style="{StaticResource Label}" Margin="0,2,0,0"/></StackPanel>
    <Border Grid.Column="2" Tag="RoundedClip" CornerRadius="8" BorderBrush="#C7D5E5" BorderThickness="1" Background="White" VerticalAlignment="Center"><ComboBox x:Name="AccessShare" BorderThickness="0"><ComboBoxItem Content="Không" Tag="None"/><ComboBoxItem Content="Chỉ đọc" Tag="Read"/><ComboBoxItem Content="Đọc &amp; ghi" Tag="Change"/></ComboBox></Border>
   </Grid>
   <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="print — tài khoản chia sẻ máy in" FontWeight="SemiBold"/><TextBlock x:Name="AccessNotePrint" Style="{StaticResource Label}" Margin="0,2,0,0"/></StackPanel>
    <Border Grid.Column="2" Tag="RoundedClip" CornerRadius="8" BorderBrush="#C7D5E5" BorderThickness="1" Background="White" VerticalAlignment="Center"><ComboBox x:Name="AccessPrint" BorderThickness="0"><ComboBoxItem Content="Không" Tag="None"/><ComboBoxItem Content="Chỉ đọc" Tag="Read"/><ComboBoxItem Content="Đọc &amp; ghi" Tag="Change"/></ComboBox></Border>
   </Grid>
   <TextBlock Text="Áp cho cả quyền chia sẻ và quyền NTFS của thư mục (thư mục con dùng chung quyền). Chỉ đổi phần của scan / share / print; quyền của người dùng khác trên máy giữ nguyên. Mật khẩu vẫn bắt buộc; không mở cho Everyone / Guest. Đọc &amp; ghi cho phép tạo, sửa, xoá file trong thư mục." Style="{StaticResource Label}" Margin="0,4,0,0"/>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Mạng và tường lửa" Style="{StaticResource Heading}"/>
   <CheckBox x:Name="Firewall" IsChecked="True" Margin="0,0,0,10"><TextBlock Text="Mở tường lửa cho chia sẻ file trong LAN: TCP 139, 445 và UDP 137, 138; chỉ mạng Private / Domain, chỉ máy cùng dải mạng. Luật riêng của TechMaster, không đổi luật có sẵn của Windows."/></CheckBox>
   <TextBlock x:Name="NetworkState" Style="{StaticResource Label}" Margin="0,0,0,8"/>
   <CheckBox x:Name="MakePrivate" IsEnabled="False"><TextBlock Text="Chuyển mạng đang Public sang Private. Chỉ chọn khi đây là mạng nội bộ của cơ quan / gia đình, không phải Wi-Fi công cộng."/></CheckBox>
  </StackPanel></Border>
  <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Đang chia sẻ trên máy này" Style="{StaticResource Heading}"/><TextBlock x:Name="SharesList" Style="{StaticResource Label}"/></StackPanel></Border>
  </StackPanel>
 <TextBlock x:Name="Log" Foreground="#526880" FontSize="12"/>
</StackPanel></ScrollViewer>
<Border Grid.Row="2" Background="White" BorderBrush="#DFE7F1" BorderThickness="0,1,0,0" Padding="22,14"><WrapPanel HorizontalAlignment="Right"><Button x:Name="Refresh" Content="Kiểm tra lại" Background="#E7EEF8" Foreground="#183655" Margin="0,0,8,8"/><Button x:Name="Apply" Content="Chia sẻ / cập nhật quyền" Margin="0,0,8,8"/><Button x:Name="Close" Content="Đóng" Background="#E7EEF8" Foreground="#183655" Margin="0,0,0,8"/></WrapPanel></Border>
</Grid></Window>
