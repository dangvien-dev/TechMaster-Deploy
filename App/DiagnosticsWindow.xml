<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Chẩn đoán UltraViewer" Width="760" Height="590" MinWidth="600" MinHeight="400" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Background="#F3F6FB">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="Heading" Text="Chẩn đoán UltraViewer — chỉ đọc" FontSize="22" FontWeight="SemiBold" Foreground="#10223F" Margin="0,0,0,16"/><Border CornerRadius="8" Tag="RoundedClip" Background="White" BorderBrush="#C7D5E5" BorderThickness="1" Grid.Row="1"><TextBox x:Name="Details" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="16" Margin="0" BorderThickness="0"/></Border><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button x:Name="Export" Content="Xuất file…" Height="44" MinWidth="110" Padding="16,0" Margin="0,0,12,0" VerticalAlignment="Center" Background="#E7EEF8" Foreground="#183655"/><Button x:Name="Copy" Content="Sao chép kết quả" Height="44" MinWidth="110" Padding="16,0" Margin="0,0,12,0" VerticalAlignment="Center" Background="#E7EEF8" Foreground="#183655"/><Button x:Name="Close" Content="Đóng" Height="44" MinWidth="110" Padding="16,0" Margin="0" VerticalAlignment="Center" IsCancel="True"/></StackPanel></Grid></Window>
