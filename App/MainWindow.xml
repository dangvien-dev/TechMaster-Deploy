<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TechMaster Deploy" Width="1160" Height="800" MinWidth="820" MinHeight="460" WindowStartupLocation="CenterScreen" Background="#F3F6FB" FontFamily="Segoe UI" FontSize="14" Foreground="#10223F" UseLayoutRounding="True">
<Window.Resources>
 <Style TargetType="Button"><Setter Property="Background" Value="#214674"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,8"/><Setter Property="MinHeight" Value="38"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter x:Name="ButtonContent" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border x:Name="FocusOutline" BorderBrush="Transparent" BorderThickness="2" CornerRadius="8" IsHitTestVisible="False"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusOutline" Property="BorderBrush" Value="#38BDF8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style x:Key="RoundedInput" TargetType="Border"><Setter Property="CornerRadius" Value="8"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#C7D5E5"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#38BDF8"/></Trigger></Style.Triggers></Style>
 <Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#E7EEF8"/><Setter Property="Foreground" Value="#183655"/></Style>
 <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#B91C1C"/></Style>
 <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style TargetType="TextBox"><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,4,0,12"/><Setter Property="BorderBrush" Value="#C7D5E5"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,6,0,12"/></Style>
 <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,6,16,6"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style TargetType="RadioButton"><Setter Property="Margin" Value="0,6,16,6"/></Style>
 <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,16"/><Setter Property="BorderBrush" Value="#DFE7F1"/><Setter Property="BorderThickness" Value="1"/></Style>
 <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
 <Style x:Key="NavigationList" TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><ScrollViewer Focusable="False" Background="{TemplateBinding Background}" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="14,13"/><Setter Property="Margin" Value="8,3"/><Setter Property="Foreground" Value="#D6E4F4"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="NavItem" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="NavItem" Property="Background" Value="#284D79"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavItem" Property="Background" Value="#214365"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="RowHeight" Value="36"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="BorderBrush" Value="#DFE7F1"/><Setter Property="Background" Value="White"/></Style>
</Window.Resources>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Grid.Row="0" Background="#10223F" Padding="24,18"><Grid x:Name="header"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="lblTitle" Text="TechMaster Deploy" Foreground="White" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="lblInfo" Text="Đang đọc thông tin máy…" Foreground="#BED2E9" Margin="0,7,20,0" FontSize="12"/></StackPanel><Grid Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center"><Button x:Name="headerUpdate" Content="Cập nhật" Style="{StaticResource Secondary}" Width="105" Height="38" Padding="16,6" Margin="0" VerticalAlignment="Center"/><Ellipse x:Name="UpdateBadge" Width="12" Height="12" Fill="#EF4444" Stroke="#10223F" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0" IsHitTestVisible="False" Visibility="Collapsed"/></Grid><Button x:Name="btnRefresh" Grid.Column="2" Content="Làm mới" Width="105" Height="38" Padding="16,6" Margin="0" VerticalAlignment="Center"/></Grid></Border>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="195"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="#142B46"><DockPanel Margin="0,16,0,0"><StackPanel DockPanel.Dock="Bottom" Margin="12,10"><Button x:Name="btnQuickGuide" Content="Hướng dẫn nhanh" Background="#284D79" Margin="0,0,0,6" Padding="10,9" FontSize="12"/><Button x:Name="btnContact" Content="Liên hệ / góp ý" Background="Transparent" Margin="0" Padding="8,6" FontSize="12"/></StackPanel><ListBox x:Name="Navigation" Style="{StaticResource NavigationList}" Background="Transparent" BorderThickness="0" SelectedIndex="0">
<ListBoxItem Content="Máy gốc / Sysprep"/>
<ListBoxItem Content="Sau khi clone"/>
<ListBoxItem Content="Kích hoạt"/>
<ListBoxItem Content="Biên bản bản quyền"/>
<ListBoxItem Content="Tải / cài Office"/>
<ListBoxItem Content="Cài Windows"/>
<ListBoxItem Content="Cài ứng dụng"/>
<ListBoxItem Content="Cập nhật"/>
</ListBox></DockPanel></Border><TabControl x:Name="tabs" Grid.Column="1" BorderThickness="0" Background="Transparent" Padding="0"><TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
<TabItem Header="Máy gốc / Sysprep"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,24"><TextBlock Text="Máy gốc / Sysprep" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,20"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Chuẩn bị trên máy gốc" Style="{StaticResource Heading}"/><TextBlock Text="Đóng Word, rút mạng trước khi chạy. Sau Sysprep máy tự tắt; clone ổ trước khi bật lại." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnSysprepCheck" Content="Kiểm tra lỗi" Style="{StaticResource Secondary}"/><Button x:Name="btnSysprep" Content="Chuẩn bị và Sysprep" Style="{StaticResource Danger}"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Cài lại phần mềm sau khi clone" Style="{StaticResource Heading}"/><TextBlock Text="Đặt bộ cài .exe / .msi vào Reinstall. File .args cùng tên dùng để chỉ định tham số riêng." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnReinstall" Content="Mở Reinstall" Style="{StaticResource Secondary}"/><Button x:Name="btnCloneHelp" Content="Hướng dẫn" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Sau khi clone"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,24"><TextBlock Text="Sau khi clone" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,20"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Xử lý thông tin trùng lặp" Style="{StaticResource Heading}"/><TextBlock Text="Đổi tên máy, tạo MachineGuid và Windows Update ID mới, xử lý ID AnyDesk / TeamViewer và dịch vụ ASUS." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnCloneFix" Content="Xử lý trùng lặp" Style="{StaticResource Danger}"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Định dạng số" Style="{StaticResource Heading}"/><TextBlock Text="Ngày dd/MM/yyyy; thập phân dấu phẩy, hàng nghìn dấu chấm: 123.456.789,00. Giữ vùng, ngôn ngữ, bàn phím và giờ." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnFormat" Content="Chỉnh ngày / số"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Bàn phím US cho EVKey" Style="{StaticResource Heading}"/><TextBlock Text="Tránh chuyển nhầm sang bộ gõ tiếng Việt của Windows. Có sao lưu và khôi phục." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnKeyboard" Content="Bàn phím / EVKey" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="UltraViewer trùng ID" Style="{StaticResource Heading}"/><TextBlock Text="Reset UID / PreferID có sao lưu, khôi phục và kiểm tra ID mới. Phần chẩn đoán vẫn chỉ đọc, giữ phiên đang chạy." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnUltraReset" Content="Đặt lại ID UltraViewer"/><Button x:Name="btnUltraDiagnostic" Content="Chẩn đoán UltraViewer" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Desktop và phím chụp màn hình" Style="{StaticResource Heading}"/><TextBlock Text="Chọn Screen Snipping cho Windows + Shift + S; sao lưu và dọn icon Word / Excel trùng mà giữ thiết lập Word." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnDesktopPreflight" Content="Kiểm tra Desktop và phím chụp" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Kích hoạt"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,24"><TextBlock Text="Kích hoạt" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,20"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Kích hoạt Windows" Style="{StaticResource Heading}"/><TextBlock Text="Kích hoạt online hoặc dùng portal Microsoft với key hợp lệ." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnActivateWindows" Content="Kích hoạt Windows"/><Button x:Name="btnPortalWindows" Content="Mở portal" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Kích hoạt Office" Style="{StaticResource Heading}"/><TextBlock Text="Đóng Word / Excel trước khi nạp Confirmation ID. Có QR và gửi mã về máy qua LAN." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnActivateOffice" Content="Kích hoạt Office"/><Button x:Name="btnPortalOffice" Content="Mở portal" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Kiểm tra QR và kết nối LAN" Style="{StaticResource Heading}"/><TextBlock Text="Chạy bằng mã giả để kiểm tra, giữ trạng thái bản quyền hiện tại." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnActivationTest" Content="Chạy thử" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Biên bản bản quyền"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,24"><TextBlock Text="Biên bản bản quyền" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,20"/><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,26,0"><TextBlock Text="Thông tin biên bản" Style="{StaticResource Heading}"/><TextBlock Text="Tên đơn vị"/><Border CornerRadius="8" Tag="RoundedClip" Style="{StaticResource RoundedInput}" Margin="0,4,0,12"><TextBox x:Name="Company" Margin="0" BorderThickness="0"/></Border><TextBlock Text="Địa chỉ"/><Border CornerRadius="8" Tag="RoundedClip" Style="{StaticResource RoundedInput}" Margin="0,4,0,12"><TextBox x:Name="Address" Margin="0" BorderThickness="0"/></Border><TextBlock Text="Điện thoại"/><Border CornerRadius="8" Tag="RoundedClip" Style="{StaticResource RoundedInput}" Margin="0,4,0,12"><TextBox x:Name="Phone" Margin="0" BorderThickness="0"/></Border><TextBlock Text="Kỹ thuật viên"/><Border CornerRadius="8" Tag="RoundedClip" Style="{StaticResource RoundedInput}" Margin="0,4,0,12"><TextBox x:Name="Technician" Margin="0" BorderThickness="0"/></Border><TextBlock Text="Khách hàng"/><Border CornerRadius="8" Tag="RoundedClip" Style="{StaticResource RoundedInput}" Margin="0,4,0,12"><TextBox x:Name="tbCustomer" Margin="0" BorderThickness="0"/></Border></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Logo đơn vị" Style="{StaticResource Heading}"/><Border BorderBrush="#DFE7F1" BorderThickness="1" Height="155" Margin="0,6,0,12" CornerRadius="8" Tag="RoundedClip"><Grid><Image x:Name="logoBox" Stretch="Uniform" Margin="8"/><WebBrowser x:Name="logoWeb" Visibility="Collapsed" Margin="8"/></Grid></Border><TextBlock x:Name="lblLogo" Margin="0,0,0,12"/><Button x:Name="btnLogo" Content="Chọn logo…" Style="{StaticResource Secondary}"/></StackPanel></Grid></Border><WrapPanel><Button x:Name="btnExport" Content="Xuất biên bản"/><Button x:Name="btnResetIdentity" Content="Xoá thông tin đơn vị / logo" Style="{StaticResource Secondary}"/><Button x:Name="btnOpenBB" Content="Mở thư mục biên bản" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Tải / cài Office"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,24"><TextBlock Text="Tải / cài Office" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,20"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Bộ cài Office" Style="{StaticResource Heading}"/><TextBlock Text="Sản phẩm"/><Border CornerRadius="8" Tag="RoundedClip" Style="{StaticResource RoundedInput}" Margin="0,6,0,12"><ComboBox x:Name="cbProduct" Margin="0" BorderThickness="0"/></Border><TextBlock x:Name="lblOffNote" Foreground="#526880" Margin="0,0,0,14"/><TextBlock Text="Ngôn ngữ bộ cài" FontWeight="SemiBold"/><WrapPanel x:Name="clLang"/><TextBlock Text="Kiến trúc" FontWeight="SemiBold" Margin="0,12,0,0"/><WrapPanel><RadioButton x:Name="rb64" Content="64-bit (khuyên dùng)" GroupName="OfficeArch" IsChecked="True"/><RadioButton x:Name="rb32" Content="32-bit" GroupName="OfficeArch"/></WrapPanel><TextBlock Text="Không cài các thành phần" FontWeight="SemiBold" Margin="0,12,0,0"/><WrapPanel x:Name="clExcl"/><TextBlock Text="Key (tuỳ chọn)" Margin="0,12,0,0"/><Border CornerRadius="8" Tag="RoundedClip" Style="{StaticResource RoundedInput}" Margin="0,4,0,12"><TextBox x:Name="tbOffKey" Margin="0" BorderThickness="0"/></Border><CheckBox x:Name="chkMsi" Content="Gỡ Office cũ dạng MSI trước khi cài"/><TextBlock x:Name="lblKho" Foreground="#526880" Margin="0,12,0,16"/><WrapPanel><Button x:Name="bDl" Content="Tải về kho"/><Button x:Name="bKho" Content="Cài từ kho"/><Button x:Name="bNet" Content="Cài trực tiếp"/><Button x:Name="bOpenKho" Content="Mở kho" Style="{StaticResource Secondary}"/><Button x:Name="bCleanup" Content="Gỡ / dọn Office…" Style="{StaticResource Danger}"/></WrapPanel><Border CornerRadius="4" Tag="RoundedClip" Background="White" BorderBrush="#DFE7F1" BorderThickness="0" Height="8" Margin="0,16,0,12"><ProgressBar x:Name="officeBar" Maximum="100" Margin="0"/></Border><TextBlock x:Name="lblOfficeProgress" Text="Sẵn sàng" Margin="0,0,0,12"/><Button x:Name="bOfficeLog" Content="Xem nhật ký" Style="{StaticResource Secondary}"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Cài Windows"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,24"><TextBlock Text="Cài Windows" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,20"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Windows 11" Style="{StaticResource Heading}"/><TextBlock Text="Tải ISO hoặc tạo USB bằng công cụ chính thức của Microsoft. USB được chọn sẽ bị xoá dữ liệu." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnIso11" Content="Trang tải Microsoft" Style="{StaticResource Secondary}"/><Button x:Name="btnUsb11" Content="Tạo USB Windows 11"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Windows 10" Style="{StaticResource Heading}"/><TextBlock Text="Tạo phương tiện cài đặt cho máy khác bằng Media Creation Tool." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnIso10" Content="Trang tải Microsoft" Style="{StaticResource Secondary}"/><Button x:Name="btnUsb10" Content="Tạo USB Windows 10"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Cài lại hoặc nâng cấp từ ISO" Style="{StaticResource Heading}"/><TextBlock Text="Mở Windows Setup từ ISO đã tải. Lựa chọn giữ dữ liệu phụ thuộc bộ cài." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnWindowsIso" Content="Chọn ISO…"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Dọn Windows.old" Style="{StaticResource Heading}"/><TextBlock Text="Mở Tệp tạm thời của Windows để dọn bản cài trước. Xoá xong sẽ mất lựa chọn quay lại." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnWindowsOld" Content="Mở mục dọn dẹp" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Cài ứng dụng"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,24"><TextBlock Text="Cài ứng dụng" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,20"/><TextBlock Text="Chọn ứng dụng để tải và cài. UltraViewer dùng bộ cài chính thức; các ứng dụng khác dùng WinGet. Nút cài chấp nhận điều khoản của các gói đã chọn." Foreground="#526880" Margin="0,0,0,18"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Chọn ứng dụng" Style="{StaticResource Heading}"/><WrapPanel x:Name="lbBasicApps"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Kết quả" Style="{StaticResource Heading}"/><Border CornerRadius="8" Tag="RoundedClip" Background="White" BorderBrush="#DFE7F1" BorderThickness="1" Height="190" Margin="0"><DataGrid x:Name="lvBasicAppResults" Margin="0" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="Ứng dụng" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="230"/></DataGrid.Columns></DataGrid></Border><Border CornerRadius="4" Tag="RoundedClip" Background="White" BorderBrush="#DFE7F1" BorderThickness="0" Height="8" Margin="0,16,0,12"><ProgressBar x:Name="basicAppBar" Margin="0"/></Border><TextBlock x:Name="lblBasicAppStatus" Text="Sẵn sàng" Margin="0,0,0,12"/><WrapPanel><Button x:Name="btnBasicAppInstall" Content="Cài ứng dụng đã chọn"/><Button x:Name="btnManageApps" Content="Quản lý ứng dụng" Style="{StaticResource Secondary}"/><Button x:Name="btnBasicAppLog" Content="Xem nhật ký" Style="{StaticResource Secondary}"/><Button x:Name="btnBasicAppHelp" Content="Hướng dẫn WinGet" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Cập nhật"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,24"><TextBlock Text="Cập nhật" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,20"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Luôn dùng phiên bản mới nhất" Style="{StaticResource Heading}"/><TextBlock Text="Kiểm tra, tải và cài bằng cửa sổ cập nhật. Giữ cấu hình, logo, biên bản, kho Office và Reinstall." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="checkUpdate" Content="Kiểm tra cập nhật"/><Button x:Name="localUpdate" Content="Cài từ tệp…" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
