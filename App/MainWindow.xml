<TabItem Header="Máy gốc / Sysprep"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,24"><TextBlock Text="Máy gốc / Sysprep" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,20"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Chuẩn bị trên máy gốc" Style="{StaticResource Heading}"/><TextBlock Text="Đóng Word, rút mạng trước khi chạy. Sau Sysprep máy tự tắt; clone ổ trước khi bật lại." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnSysprepCheck" Content="Kiểm tra lỗi" Style="{StaticResource Secondary}"/><Button x:Name="btnSysprep" Content="Chuẩn bị và Sysprep" Style="{StaticResource Danger}"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Cài lại phần mềm sau khi clone" Style="{StaticResource Heading}"/><TextBlock Text="Đặt bộ cài .exe / .msi vào Reinstall. File .args cùng tên dùng để chỉ định tham số riêng." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnReinstall" Content="Mở Reinstall" Style="{StaticResource Secondary}"/><Button x:Name="btnCloneHelp" Content="Hướng dẫn" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Sau khi clone"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,24"><TextBlock Text="Sau khi clone" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,20"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Xử lý thông tin trùng lặp" Style="{StaticResource Heading}"/><TextBlock Text="Đổi tên máy, tạo MachineGuid và Windows Update ID mới, xử lý ID AnyDesk / TeamViewer và dịch vụ ASUS." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnCloneFix" Content="Xử lý trùng lặp" Style="{StaticResource Danger}"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Định dạng số" Style="{StaticResource Heading}"/><TextBlock Text="Ngày dd/MM/yyyy; thập phân dấu phẩy, hàng nghìn dấu chấm: 123.456.789,00. Giữ vùng, ngôn ngữ, bàn phím và giờ." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnFormat" Content="Chỉnh ngày / số"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Bàn phím US cho EVKey" Style="{StaticResource Heading}"/><TextBlock Text="Tránh chuyển nhầm sang bộ gõ tiếng Việt của Windows. Có sao lưu và khôi phục." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnKeyboard" Content="Bàn phím / EVKey" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Máy in và ứng dụng mặc định" Style="{StaticResource Heading}"/><TextBlock Text="Đặt máy in mặc định, khổ A4; gỡ nhanh máy in không còn kết nối; chọn trình duyệt web và ứng dụng đọc PDF, rồi kiểm tra lại thiết lập Windows." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnDefaults" Content="Thiết lập mặc định…"/><Button x:Name="btnPrinterCleanup" Content="Dọn máy in không kết nối…" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Menu chuột phải" Style="{StaticResource Heading}"/><TextBlock Text="Chọn kiểu menu cho tài khoản đang chạy app trên Windows 11. Cần khởi động lại Explorer để kiểm tra. Một số bản Windows mới có thể bỏ qua tuỳ chỉnh; cùng build vẫn có thể khác do triển khai dần." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnMenuClassic" Content="Kiểu Windows 10…" Style="{StaticResource Secondary}"/><Button x:Name="btnMenuDefault" Content="Khôi phục Windows 11…" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="UltraViewer trùng ID" Style="{StaticResource Heading}"/><TextBlock Text="Reset UID / PreferID có sao lưu, khôi phục và kiểm tra ID mới. Phần chẩn đoán vẫn chỉ đọc, giữ phiên đang chạy." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnUltraReset" Content="Đặt lại ID UltraViewer"/><Button x:Name="btnUltraDiagnostic" Content="Chẩn đoán UltraViewer" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Desktop và phím chụp màn hình" Style="{StaticResource Heading}"/><TextBlock Text="Chọn Screen Snipping cho Windows + Shift + S; sao lưu và dọn icon Word / Excel trùng mà giữ thiết lập Word." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnDesktopPreflight" Content="Kiểm tra Desktop và phím chụp" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Kích hoạt"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,24"><TextBlock Text="Kích hoạt" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,20"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Kích hoạt Windows" Style="{StaticResource Heading}"/><TextBlock Text="Kích hoạt online hoặc dùng portal Microsoft với key hợp lệ." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnActivateWindows" Content="Kích hoạt Windows"/><Button x:Name="btnPortalWindows" Content="Mở portal" Style="{StaticResource Secondary}"/><Button x:Name="btnWindowsSetupKey" Content="Key cài đặt chung Windows…" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Kích hoạt Office" Style="{StaticResource Heading}"/><TextBlock Text="Đóng Word / Excel trước khi nạp Confirmation ID. Có QR và gửi mã về máy qua LAN." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnActivateOffice" Content="Kích hoạt Office"/><Button x:Name="btnPortalOffice" Content="Mở portal" Style="{StaticResource Secondary}"/><Button x:Name="bCleanup" Content="Key dùng tạm Office…" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Kiểm tra QR và kết nối LAN" Style="{StaticResource Heading}"/><TextBlock Text="Chạy bằng mã giả để kiểm tra, giữ trạng thái bản quyền hiện tại." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnActivationTest" Content="Chạy thử" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Biên bản bản quyền"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,24"><TextBlock Text="Biên bản bản quyền" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,20"/><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,26,0"><TextBlock Text="Thông tin biên bản" Style="{StaticResource Heading}"/><TextBlock Text="Tên đơn vị"/><Border CornerRadius="8" Tag="RoundedClip" Style="{StaticResource RoundedInput}" Margin="0,4,0,12"><TextBox x:Name="Company" Margin="0" BorderThickness="0"/></Border><TextBlock Text="Địa chỉ"/><Border CornerRadius="8" Tag="RoundedClip" Style="{StaticResource RoundedInput}" Margin="0,4,0,12"><TextBox x:Name="Address" Margin="0" BorderThickness="0"/></Border><TextBlock Text="Điện thoại"/><Border CornerRadius="8" Tag="RoundedClip" Style="{StaticResource RoundedInput}" Margin="0,4,0,12"><TextBox x:Name="Phone" Margin="0" BorderThickness="0"/></Border><TextBlock Text="Kỹ thuật viên"/><Border CornerRadius="8" Tag="RoundedClip" Style="{StaticResource RoundedInput}" Margin="0,4,0,12"><TextBox x:Name="Technician" Margin="0" BorderThickness="0"/></Border><TextBlock Text="Khách hàng / người nhận"/><Border CornerRadius="8" Tag="RoundedClip" Style="{StaticResource RoundedInput}" Margin="0,4,0,12"><TextBox x:Name="tbCustomer" Margin="0" BorderThickness="0"/></Border><TextBlock Text="Đơn vị / công ty khách hàng (tuỳ chọn)"/><Border CornerRadius="8" Tag="RoundedClip" Style="{StaticResource RoundedInput}" Margin="0,4,0,12"><TextBox x:Name="tbCustomerCompany" Margin="0" BorderThickness="0"/></Border><TextBlock Text="Địa chỉ khách hàng (tuỳ chọn)"/><Border CornerRadius="8" Tag="RoundedClip" Style="{StaticResource RoundedInput}" Margin="0,4,0,12"><TextBox x:Name="tbCustomerAddress" Margin="0" BorderThickness="0"/></Border><TextBlock Text="Thông tin khách hàng dùng cho biên bản đang lập." FontSize="12" Foreground="#526880"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Logo đơn vị" Style="{StaticResource Heading}"/><Border BorderBrush="#DFE7F1" BorderThickness="1" Height="155" Margin="0,6,0,12" CornerRadius="8" Tag="RoundedClip"><Image x:Name="logoBox" Stretch="Uniform" Margin="8"/></Border><TextBlock x:Name="lblLogo" Margin="0,0,0,12"/><Button x:Name="btnLogo" Content="Chọn logo…" Style="{StaticResource Secondary}"/><Button x:Name="btnRemoveLogo" Content="Xoá logo" Style="{StaticResource Secondary}" Foreground="#B91C1C" IsEnabled="False"/></StackPanel></Grid></Border><WrapPanel><Button x:Name="btnSaveIdentity" Content="Lưu thông tin" Style="{StaticResource Secondary}"/><Button x:Name="btnExport" Content="Xuất biên bản"/><Button x:Name="btnResetIdentity" Content="Xoá thông tin đơn vị / logo" Style="{StaticResource Secondary}"/><Button x:Name="btnOpenBB" Content="Mở thư mục biên bản" Style="{StaticResource Secondary}"/></WrapPanel><Border Style="{StaticResource Card}" Margin="0,16,0,16"><StackPanel><TextBlock Text="Xác nhận cung cấp và bàn giao bản quyền" Style="{StaticResource Heading}"/><TextBlock Text="Hai mẫu riêng để đơn vị cung cấp ký và giao khách. Chọn phần mềm thực tế đã bàn giao; thông tin hóa đơn của mẫu công ty là tuỳ chọn." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnConfirmRetail" Content="Xác nhận cho khách lẻ…"/><Button x:Name="btnConfirmCompany" Content="Xác nhận cho công ty…" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Tải / cài Office"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,24"><TextBlock Text="Tải / cài Office" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,20"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Bộ cài Office" Style="{StaticResource Heading}"/><TextBlock Text="Sản phẩm"/><Border CornerRadius="8" Tag="RoundedClip" Style="{StaticResource RoundedInput}" Margin="0,6,0,12"><ComboBox x:Name="cbProduct" Margin="0" BorderThickness="0"/></Border><TextBlock x:Name="lblOffNote" Foreground="#526880" Margin="0,0,0,14"/><TextBlock Text="Ngôn ngữ bộ cài" FontWeight="SemiBold"/><WrapPanel x:Name="clLang"/><TextBlock Text="Kiến trúc" FontWeight="SemiBold" Margin="0,12,0,0"/><WrapPanel><RadioButton x:Name="rb64" Content="64-bit (khuyên dùng)" GroupName="OfficeArch" IsChecked="True"/><RadioButton x:Name="rb32" Content="32-bit" GroupName="OfficeArch"/></WrapPanel><TextBlock Text="Không cài các thành phần" FontWeight="SemiBold" Margin="0,12,0,0"/><WrapPanel x:Name="clExcl"/><TextBlock Text="Key (tuỳ chọn)" Margin="0,12,0,0"/><Border CornerRadius="8" Tag="RoundedClip" Style="{StaticResource RoundedInput}" Margin="0,4,0,12"><TextBox x:Name="tbOffKey" Margin="0" BorderThickness="0"/></Border><CheckBox x:Name="chkMsi" Content="Gỡ Office cũ dạng MSI trước khi cài"/><TextBlock x:Name="lblKho" Foreground="#526880" Margin="0,12,0,16"/><WrapPanel><Button x:Name="bDl" Content="Tải về kho"/><Button x:Name="bKho" Content="Cài từ kho"/><Button x:Name="bNet" Content="Cài trực tiếp"/><Button x:Name="bOpenKho" Content="Mở kho" Style="{StaticResource Secondary}"/><Button x:Name="bRemoveOffice" Content="Gỡ Office…" Style="{StaticResource Danger}"/></WrapPanel><Border CornerRadius="4" Tag="RoundedClip" Background="White" BorderBrush="#DFE7F1" BorderThickness="0" Height="8" Margin="0,16,0,12"><ProgressBar x:Name="officeBar" Maximum="100" Margin="0"/></Border><Border Tag="Notice" Margin="0,0,0,1