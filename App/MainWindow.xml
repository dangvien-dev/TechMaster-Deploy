</StackPanel></ScrollViewer></TabItem>
</TabControl></Grid><Border Grid.Row="2" Background="#E5EDF7" Padding="20,10"><TextBlock x:Name="status" Text="Sẵn sàng" FontSize="12" Foreground="#405A76"/></Border></Grid></Window>