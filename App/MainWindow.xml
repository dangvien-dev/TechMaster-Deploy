<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Cài lại hoặc nâng cấp từ ISO" Style="{StaticResource Heading}"/><TextBlock Text="Mở Windows Setup từ ISO đã tải. Lựa chọn giữ dữ liệu phụ thuộc bộ cài." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnWindowsIso" Content="Chọn ISO…"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Cài lại Paint" Style="{StaticResource Heading}"/><TextBlock Text="Thiếu ứng dụng Paint? Mở trang Paint chính thức của Microsoft, bấm Get / Cài đặt trong Microsoft Store." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnPaintStore" Content="Paint trên Microsoft Store" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Dọn Windows.old" Style="{StaticResource Heading}"/><TextBlock Text="Kiểm tra thư mục và mở Disk Cleanup với quyền quản trị. Chọn Dọn tệp hệ thống → Bản cài đặt Windows trước đây. Xoá xong sẽ mất lựa chọn quay lại." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnWindowsOld" Content="Dọn Windows.old…" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Cài ứng dụng"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,24"><TextBlock Text="Cài ứng dụng" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,20"/><TextBlock Text="Chọn ứng dụng để tải và cài. UltraViewer dùng bộ cài chính thức; các ứng dụng khác dùng WinGet. Nút cài chấp nhận điều khoản của các gói đã chọn." Foreground="#526880" Margin="0,0,0,18"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Chọn ứng dụng" Style="{StaticResource Heading}"/><WrapPanel x:Name="lbBasicApps"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Kết quả" Style="{StaticResource Heading}"/><Border CornerRadius="8" Tag="RoundedClip" Background="White" BorderBrush="#DFE7F1" BorderThickness="1" Height="190" Margin="0"><DataGrid x:Name="lvBasicAppResults" Margin="0" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="Ứng dụng" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="230"/></DataGrid.Columns></DataGrid></Border><Border CornerRadius="4" Tag="RoundedClip" Background="White" BorderBrush="#DFE7F1" BorderThickness="0" Height="8" Margin="0,16,0,12"><ProgressBar x:Name="basicAppBar" Margin="0"/></Border><Border Tag="Notice" Margin="0,0,0,12"><TextBlock x:Name="lblBasicAppStatus" Text="Sẵn sàng" Margin="0"/></Border><WrapPanel><Button x:Name="btnBasicAppInstall" Content="Cài ứng dụng đã chọn"/><Button x:Name="btnManageApps" Content="Quản lý ứng dụng" Style="{StaticResource Secondary}"/><Button x:Name="btnBasicAppLog" Content="Xem nhật ký" Style="{StaticResource Secondary}"/><Button x:Name="btnBasicAppHelp" Content="Hướng dẫn WinGet" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Cập nhật"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,24"><TextBlock Text="Cập nhật" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,20"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Luôn dùng phiên bản mới nhất" Style="{StaticResource Heading}"/><TextBlock Text="Kiểm tra, tải và cài bằng cửa sổ cập nhật. Giữ cấu hình, logo, biên bản, kho Office và Reinstall." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="checkUpdate" Content="Kiểm tra cập nhật"/><Button x:Name="localUpdate" Content="Cài từ tệp…" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Lịch sử và khôi phục" Style="{StaticResource Heading}"/><TextBlock Text="Ứng dụng sao lưu trước khi cập nhật. Có thể khôi phục bản trước khi cần." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="historyUpdate" Content="Lịch sử cập nhật" Style="{StaticResource Secondary}"/><Button x:Name="rollbackUpdate" Content="Khôi phục bản trước" Style="{StaticResource Secondary}"/><Button x:Name="changeLogUpdate" Content="Có gì mới?" Style="{StaticResource Secondary}"/></WrapPanel></StackPanel></Border>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Chẩn đoán &amp; sửa lỗi"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="26,24"><TextBlock Text="Chẩn đoán &amp; sửa lỗi" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,20"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Thiếu driver và thiết bị báo lỗi" Style="{StaticResource Heading}"/><TextBlock Text="Quét Hardware ID, tạo link Microsoft Update Catalog, cài CAB / INF đã tải và đối chiếu kho driver USB / NAS. Quét lại theo vòng để phát hiện thiết bị con." Foreground="#526880" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnDriverFix" Content="Mở Fix Driver"/><Button x:Name="btnDriverGuide" Content="Hướng dẫn" Style="{StaticResource Secondary}"/></WrapPanel><TextBlock Text="Dùng chung cho mọi máy, không cần profile để quét và cài. Profile theo dòng máy chỉ bổ sung gợi ý khi nhận diện đúng. Tool không tải hoặc đóng gói driver." Foreground="#526880"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Ứng dụng bị báo virus / không mở được" Style="{StaticResource Heading}"/><TextBlock Text="Chẩn đoán (chỉ đọc): AV đang bật, lịch sử phát hiện Defender / nhật ký Kaspersky, dấu hiệu virus lây file, chữ ký số Office / Zalo, công cụ kích hoạt, ngoại lệ. Sau khi chẩn đoán, Sửa lỗi… cho chọn: cập nhật và quét Defender, gỡ cho phép / ngoại lệ rộng, tắt AppInit_DLLs, cách ly tệp còn sót (không xoá), quét offline." Foreground="#526880" TextWrapping="Wrap" Margin="0,0,0,18"/><WrapPanel><Button x:Name="btnAvDiagnostic" Content="Chẩn đoán báo virus" Style="{StaticResource Secondary}"/><Button x:Name="btnAvRepair" Content="Sửa lỗi…" Visibility="Collapsed"/><Button x:Name="btnAvLastResult" Content="Xem kết quả gần nhất" Style="{StaticResource Secondary}" Visibility="Collapsed"/></WrapPanel><CheckBox x:Name="chkAvDeep" Content="Quét sâu: kiểm tra cả .dll (chậm, chỉ dùng khi máy rảnh)" Margin="0,4,0,0"/><StackPanel x:Name="avProgressPanel" Visibility="Collapsed"><Border CornerRadius="4" Tag="RoundedClip" Background="White" BorderBrush="#DFE7F1" BorderThickness="0" Height="8" Margin="0,16,0,12"><ProgressBar x:Name="avBar" Maximum="100" Margin="0"/></Border><Border Tag="Notice" Margin="0"><TextBlock x:Name="lblAvProgress" Text="Sẵn sàng" TextWrapping="Wrap" Margin="0"/></Border></StackPanel></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
</TabControl></Grid><Border Grid.Row="2" Background="#E5EDF7" Padding="20,10"><Border Tag="Notice"><TextBlock x:Name="status" Text="Sẵn sàng" FontSize="12" Foreground="#405A76" Margin="0"/></Border></Border></Grid></Window>