<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Quản lý ứng dụng" Width="850" Height="620" MinWidth="650" MinHeight="450" WindowStartupLocation="CenterScreen" Background="#F3F6FB" Foreground="#10223F" FontFamily="Segoe UI" FontSize="14">
<Window.Resources><Style TargetType="Button"><Setter Property="Background" Value="#214674"/><Setter Property="Foreground" Value="White"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,10,0"/></Style><Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,6,0,14"/></Style></Window.Resources>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="#10223F" Padding="24,20"><StackPanel><TextBlock Text="Ứng dụng bổ sung" FontSize="24" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="Chỉ lưu trên máy này, theo tài khoản Windows đang dùng. Không đồng bộ lên repo." Foreground="#BED2E9" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
<Grid Grid.Row="1" Margin="22"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><DockPanel><Button x:Name="New" Content="Thêm ứng dụng" DockPanel.Dock="Bottom" Margin="0,12,0,0"/><Border CornerRadius="8" Tag="RoundedClip" Background="White" BorderBrush="#C7D5E5" BorderThickness="1"><ListBox x:Name="Apps" DisplayMemberPath="Name" Margin="0" BorderThickness="0"/></Border></DockPanel><ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Tên hiển thị"/><Border CornerRadius="8" Tag="RoundedClip" BorderBrush="#C7D5E5" BorderThickness="1" Background="White" Margin="0,6,0,14"><TextBox x:Name="AppName" Margin="0" BorderThickness="0"/></Border><TextBlock Text="Nguồn cài"/><Border CornerRadius="8" Tag="RoundedClip" BorderBrush="#C7D5E5" BorderThickness="1" Background="White" Margin="0,6,0,14"><ComboBox x:Name="Provider" SelectedIndex="0" Padding="9,7" Margin="0" BorderThickness="0"><ComboBoxItem Content="WinGet" Tag="WinGet"/><ComboBoxItem Content="Bộ cài EXE / MSI trên máy" Tag="Local"/></ComboBox></Border><StackPanel x:Name="WingetFields"><TextBlock Text="ID WinGet"/><Border CornerRadius="8" Tag="RoundedClip" BorderBrush="#C7D5E5" BorderThickness="1" Background="White" Margin="0,6,0,14"><TextBox x:Name="PackageId" Margin="0" BorderThickness="0"/></Border><TextBlock Text="Ví dụ: Microsoft.PowerToys. Dùng đúng ID gói trong kho WinGet." Foreground="#526880" TextWrapping="Wrap"/></StackPanel><StackPanel x:Name="LocalFields" Visibility="Collapsed"><TextBlock Text="Đường dẫn bộ cài"/><Border CornerRadius="8" Tag="RoundedClip" BorderBrush="#C7D5E5" BorderThickness="1" Background="White" Margin="0,6,0,14"><TextBox x:Name="InstallerPath" Margin="0" BorderThickness="0"/></Border><Button x:Name="Browse" Content="Chọn EXE / MSI…" HorizontalAlignment="Left"/><TextBlock Text="Tham số cài đặt (tuỳ chọn)" Margin="0,16,0,0"/><Border CornerRadius="8" Tag="RoundedClip" BorderBrush="#C7D5E5" BorderThickness="1" Background="White" Margin="0,6,0,14"><TextBox x:Name="Arguments" Margin="0" BorderThickness="0"/></Border><TextBlock Text="Ví dụ /S hoặc /quiet. Để trống để hiện trình cài đặt. Giữ bộ cài tại đường dẫn đã chọn; app không sao chép bộ cài sang máy khác." Foreground="#526880" TextWrapping="Wrap"/></StackPanel><WrapPanel Margin="0,22,0,0"><Button x:Name="Save" Content="Lưu trên máy này"/><Button x:Name="Delete" Content="Xoá mục"/></WrapPanel></StackPanel></ScrollViewer></Grid>
<Border Grid.Row="2" Background="White" Padding="22,16"><DockPanel><Button x:Name="Close" Content="Đóng" DockPanel.Dock="Right" Margin="16,0,0,0" IsCancel="True"/><TextBlock x:Name="Status" Text="Ứng dụng mặc định vẫn được giữ. Danh sách bổ sung không mất khi cập nhật app." TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#526880"/></DockPanel></Border></Grid></Window>