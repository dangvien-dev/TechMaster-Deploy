<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Sửa lỗi báo virus" Width="860" Height="700" MinWidth="640" MinHeight="480" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Background="#F3F6FB" Foreground="#10223F">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Text="Sửa lỗi báo virus" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8"/>
<TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="#526880" Margin="0,0,0,14" Text="Danh sách lập từ lần chẩn đoán gần nhất. Mục khuyến nghị đã được chọn sẵn. Thao tác chạy theo thứ tự cố định (cập nhật → gỡ cho phép / ngoại lệ → AppInit → cách ly → quét → quét offline), mỗi mục được kiểm tra lại và ghi nhật ký. Không xoá tệp: tệp còn sót được chuyển vào _CachLy_Virus."/>
<Border Grid.Row="2" CornerRadius="8" Tag="RoundedClip" Background="White" BorderBrush="#C7D5E5" BorderThickness="1"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Items" Margin="16,12"/></ScrollViewer></Border>
<StackPanel Grid.Row="3" Margin="0,14,0,0"><Border CornerRadius="4" Tag="RoundedClip" Background="White" BorderBrush="#DFE7F1" BorderThickness="0" Height="8" Margin="0,0,0,10"><ProgressBar x:Name="Bar" Maximum="100" Margin="0"/></Border><Border Tag="Notice" Margin="0"><TextBlock x:Name="Status" Text="Chọn thao tác rồi bấm Chạy mục đã chọn." TextWrapping="Wrap" Margin="0"/></Border></StackPanel>
<Border Grid.Row="4" CornerRadius="8" Tag="RoundedClip" Background="White" BorderBrush="#C7D5E5" BorderThickness="1" Height="130" Margin="0,10,0,0"><TextBox x:Name="Log" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="12" Margin="0" BorderThickness="0" FontFamily="Consolas" FontSize="13"/></Border>
<StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button x:Name="OpenLog" Content="Mở nhật ký" Height="44" MinWidth="110" Padding="16,0" Margin="0,0,12,0" VerticalAlignment="Center" Background="#E7EEF8" Foreground="#183655" IsEnabled="False"/><Button x:Name="Recommended" Content="Chọn mục khuyến nghị" Height="44" MinWidth="110" Padding="16,0" Margin="0,0,12,0" VerticalAlignment="Center" Background="#E7EEF8" Foreground="#183655"/><Button x:Name="Run" Content="Chạy mục đã chọn" Height="44" MinWidth="110" Padding="16,0" Margin="0,0,12,0" VerticalAlignment="Center"/><Button x:Name="Close" Content="Đóng" Height="44" MinWidth="110" Padding="16,0" Margin="0" VerticalAlignment="Center" Background="#E7EEF8" Foreground="#183655"/></StackPanel>
</Grid></Window>
