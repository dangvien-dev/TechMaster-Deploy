<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TechMaster Deploy" Width="900" Height="680" MinWidth="650" MinHeight="430" WindowStartupLocation="CenterScreen" Background="#F3F6FB" Foreground="#10223F" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
<Window.Resources>
<Style TargetType="Button"><Setter Property="Padding" Value="18,10"/><Setter Property="Background" Value="#214674"/><Setter Property="Foreground" Value="White"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="ListBoxItem"><Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Surface" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#214674"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
</Window.Resources>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="#10223F" Padding="26,22"><StackPanel><TextBlock x:Name="Heading" FontSize="25" FontWeight="SemiBold" Foreground="White"/><TextBlock x:Name="VersionInfo" Foreground="#BED2E9" Margin="0,8,0,0"/></StackPanel></Border>
<Grid Grid.Row="1" Margin="22"><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<ListBox x:Name="Sections" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate></ListBox>
<Border Grid.Column="2" CornerRadius="12" BorderBrush="#DFE7F1" BorderThickness="1" Background="White" Padding="22"><ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><TextBlock x:Name="ContentTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="ContentSubtitle" Foreground="#526880" Margin="0,8,0,20" TextWrapping="Wrap"/><ItemsControl x:Name="Notes"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="•" Foreground="#2B6CA3" FontSize="17"/><TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" LineHeight="23"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Border>
</Grid>
<Border Grid.Row="2" Background="White" BorderBrush="#DFE7F1" BorderThickness="0,1,0,0" Padding="22,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Liên hệ / góp ý / báo lỗi" FontWeight="SemiBold" Margin="0,0,0,8"/><WrapPanel><TextBlock Margin="0,0,18,5"><Hyperlink x:Name="ZaloLink" NavigateUri="https://zalo.me/0976852096">Zalo: 0976852096</Hyperlink></TextBlock><TextBlock Margin="0,0,18,5"><Hyperlink x:Name="MailLink" NavigateUri="mailto:vienkendo@gmail.com">vienkendo@gmail.com</Hyperlink></TextBlock><Button x:Name="CopyContact" Content="Sao chép liên hệ" Padding="10,5" Background="#E7EEF8" Foreground="#183655" FontSize="12"/></WrapPanel><TextBlock x:Name="ContactStatus" Foreground="#526880" FontSize="12" Margin="0,4,0,0"/></StackPanel><Button x:Name="Close" Grid.Column="1" Content="Đóng" MinWidth="100" VerticalAlignment="Center" Margin="16,0,0,0" IsCancel="True"/></Grid></Border>
</Grid></Window>
