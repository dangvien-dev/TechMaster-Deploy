<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TechMaster Deploy" Width="560" SizeToContent="Height" MaxHeight="650" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#F3F6FB" FontFamily="Segoe UI" FontSize="14" Foreground="#10223F" ShowInTaskbar="False">
<Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="20,11"/><Setter Property="MinWidth" Value="110"/><Setter Property="Margin" Value="10,0,0,0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Background" Value="#214674"/><Setter Property="Foreground" Value="White"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#38BDF8"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Window.Resources>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="#10223F" Padding="26,20"><TextBlock x:Name="Heading" Foreground="White" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/></Border><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="420"><StackPanel Margin="26,24"><TextBlock x:Name="Message" TextWrapping="Wrap" LineHeight="23"/><Border CornerRadius="8" Tag="RoundedClip" Background="White" BorderBrush="#C7D5E5" BorderThickness="1" Margin="0,16,0,0" Visibility="{Binding Visibility, ElementName=Input}"><TextBox x:Name="Input" Visibility="Collapsed" Padding="10" Margin="0" BorderThickness="0"/></Border></StackPanel></ScrollViewer><Border Grid.Row="2" Background="White" Padding="18,16"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Content="Huỷ" Background="#E7EEF8" Foreground="#183655" IsCancel="True" IsDefault="True"/><Button x:Name="Alternate" Content="Lựa chọn khác" Visibility="Collapsed"/><Button x:Name="Confirm" Content="Xác nhận"/></StackPanel></Border></Grid></Window>
