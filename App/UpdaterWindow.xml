<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Cập nhật TechMaster Deploy" Width="680" Height="530" MinWidth="620" MinHeight="480" WindowStartupLocation="CenterScreen" Background="#F3F6FB" Foreground="#10223F" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
<Window.Resources>
 <Style TargetType="Button"><Setter Property="Background" Value="#214674"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="18,11"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="MinWidth" Value="108"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#38BDF8"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
</Window.Resources>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="#10223F" Padding="28,22"><StackPanel><TextBlock Text="Cập nhật TechMaster Deploy" FontSize="24" FontWeight="SemiBold" Foreground="White"/><TextBlock x:Name="CurrentVersion" Text="Chọn ứng dụng đang dùng để tiếp tục" Margin="0,8,0,0" Foreground="#BED2E9"/></StackPanel></Border>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="28,24">
<Border Background="White" CornerRadius="12" Padding="22" BorderBrush="#DFE7F1" BorderThickness="1"><StackPanel>
<TextBlock x:Name="Heading" Text="Sẵn sàng" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/>
<TextBlock x:Name="Summary" Text="Kiểm tra phiên bản mới và cài đặt ngay tại đây." Foreground="#526880" Margin="0,0,0,18"/>
<Border CornerRadius="4" Tag="RoundedClip" Background="White" BorderBrush="#C7D5E5" BorderThickness="0" Margin="0,0,0,16" Height="8"><ProgressBar x:Name="Progress" Minimum="0" Maximum="100" Margin="0" BorderThickness="0"/></Border>
<TextBlock Text="Giữ cấu hình, logo, biên bản, kho Office, ODT, nhật ký và Reinstall. Phiên bản hiện tại được sao lưu trước khi thay tệp." FontSize="12" Foreground="#647A92"/>
<StackPanel x:Name="RootPicker" Visibility="Collapsed" Margin="0,18,0,0"><TextBlock Text="Thư mục ứng dụng đang dùng"/><Border CornerRadius="8" Tag="RoundedClip" Background="White" BorderBrush="#C7D5E5" BorderThickness="1" Margin="0,8,0,12"><TextBox x:Name="RootPath" Padding="10,8" Margin="0" BorderThickness="0"/></Border><Button x:Name="BrowseRoot" Content="Chọn TechMaster Deploy.exe…" HorizontalAlignment="Left" Margin="0"/></StackPanel>
<StackPanel x:Name="AccessPanel" Visibility="Collapsed" Margin="0,18,0,0"><TextBlock Text="Nhập quyền đọc do người quản lý cung cấp. Dữ liệu chỉ lưu mã hoá cho tài khoản Windows này."/><Border CornerRadius="8" Tag="RoundedClip" Background="White" BorderBrush="#C7D5E5" BorderThickness="1" Margin="0,10,0,10"><PasswordBox x:Name="AccessToken" Padding="10" Margin="0" BorderThickness="0"/></Border><WrapPanel><Button x:Name="SaveAccess" Content="Lưu quyền đọc"/><Button x:Name="RemoveAccess" Content="Xoá quyền đã lưu"/></WrapPanel></StackPanel>
</StackPanel></Border>
<Button x:Name="ChoosePackage" Content="Chọn tệp cập nhật offline…" HorizontalAlignment="Left" Margin="0,16,0,0" Background="#E7EEF8" Foreground="#183655"/>
<Border CornerRadius="8" Tag="RoundedClip" Background="White" BorderBrush="#C7D5E5" BorderThickness="1" Margin="0,18,0,0" Height="210" Visibility="{Binding Visibility, ElementName=HistoryGrid}"><DataGrid x:Name="HistoryGrid" Visibility="Collapsed" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Margin="0" BorderThickness="0"><DataGrid.Columns><DataGridTextColumn Header="Thời điểm" Binding="{Binding Date}" Width="*"/><DataGridTextColumn Header="Từ bản" Binding="{Binding From}" Width="90"/><DataGridTextColumn Header="Đến bản" Binding="{Binding To}" Width="90"/><DataGridTextColumn Header="Kết quả" Binding="{Binding Status}" Width="130"/></DataGrid.Columns></DataGrid></Border>
</StackPanel></ScrollViewer>
<Border Grid.Row="2" Background="White" BorderBrush="#DFE7F1" BorderThickness="0,1,0,0" Padding="20,16"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Content="Đóng" Background="#E7EEF8" Foreground="#183655"/><Button x:Name="Primary" Content="Kiểm tra cập nhật" IsDefault="True"/></StackPanel></Border>
</Grid></Window>
