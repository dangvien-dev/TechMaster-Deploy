<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Kết nối máy in mạng / chia sẻ" Width="880" Height="820" MinWidth="640" MinHeight="460" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14" Background="#F3F6FB" Foreground="#10223F" UseLayoutRounding="True">
<Window.Resources>
 <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,8"/><Setter Property="MinHeight" Value="36"/></Style>
 <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="BorderBrush" Value="#DFE7F1"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,14"/></Style>
 <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
 <Style x:Key="Label" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#526880"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
</Window.Resources>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="#10223F" Padding="24,20"><StackPanel><TextBlock x:Name="Heading" Text="Kết nối máy in mạng / chia sẻ" FontSize="24" FontWeight="SemiBold" Foreground="White"/><TextBlock x:Name="Subtitle" Foreground="#BED2E9" Margin="0,8,0,0" Text="Không tắt bảo mật in của Windows: dùng cổng TCP/IP, tài khoản có mật khẩu và driver cài sẵn."/></StackPanel></Border>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="22,18,22,8">
 <Border Tag="Notice" Margin="0,0,0,14"><TextBlock x:Name="Status" Text="Đang đọc driver máy in…"/></Border>
 <StackPanel x:Name="Choices">
  <Border x:Name="IpCard" Style="{StaticResource Card}"><StackPanel>
   <TextBlock Text="Máy in có cổng mạng (LAN / Wi-Fi)" Style="{StaticResource Heading}"/>
   <TextBlock Text="In thẳng tới máy in qua Standard TCP/IP, không đi qua máy tính khác: không gặp lỗi 0x0000011b / 0x00000709 / 0x00000bcb. Nên đặt IP tĩnh (hoặc DHCP reservation trên router / MikroTik) cho máy in." Style="{StaticResource Label}" Margin="0,0,0,12"/>
   <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Địa chỉ IP máy in" Style="{StaticResource Label}"/><Border Tag="RoundedClip" CornerRadius="8" BorderBrush="#C7D5E5" BorderThickness="1" Background="White"><TextBox x:Name="Address" BorderThickness="0" Padding="10,8" MinHeight="36" VerticalContentAlignment="Center"/></Border></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Cổng (RAW)" Style="{StaticResource Label}"/><Border Tag="RoundedClip" CornerRadius="8" BorderBrush="#C7D5E5" BorderThickness="1" Background="White"><TextBox x:Name="PortNumber" Text="9100" BorderThickness="0" Padding="10,8" MinHeight="36" VerticalContentAlignment="Center"/></Border></StackPanel>
   </Grid>
   <TextBlock Text="Tên máy in trên máy này" Style="{StaticResource Label}"/><Border Tag="RoundedClip" CornerRadius="8" BorderBrush="#C7D5E5" BorderThickness="1" Background="White"><TextBox x:Name="PrinterName" BorderThickness="0" Padding="10,8" MinHeight="36" VerticalContentAlignment="Center"/></Border>
   <TextBlock Text="Ví dụ Photocopy Toshiba tầng 2. Để trống: app đặt theo model và IP." Style="{StaticResource Label}" Margin="0,4,0,12"/>
   <WrapPanel><CheckBox x:Name="SetA4" IsChecked="True" Margin="0,0,18,8"><TextBlock Text="Đặt khổ A4"/></CheckBox><CheckBox x:Name="SetDefault" Margin="0,0,18,8"><TextBlock Text="Đặt làm máy in mặc định"/></CheckBox><CheckBox x:Name="TestPage" Margin="0,0,0,8"><TextBlock Text="In trang thử"/></CheckBox></WrapPanel>
  </StackPanel></Border>
  <Border x:Name="ShareCard" Style="{StaticResource Card}"><StackPanel>
   <TextBlock Text="Máy in chia sẻ từ máy khác" Style="{StaticResource Heading}"/>
   <TextBlock Text="Dùng cho máy in USB cắm vào một máy tính rồi chia sẻ. Kết nối bằng tài khoản có mật khẩu trên máy chủ in (tạo tài khoản print ở Mạng LAN &amp; chia sẻ); app không dùng Guest hay tài khoản không mật khẩu." Style="{StaticResource Label}" Margin="0,0,0,12"/>
   <TextBlock Text="Đường dẫn máy in chia sẻ" Style="{StaticResource Label}"/><Border Tag="RoundedClip" CornerRadius="8" BorderBrush="#C7D5E5" BorderThickness="1" Background="White"><TextBox x:Name="SharePath" BorderThickness="0" Padding="10,8" MinHeight="36" VerticalContentAlignment="Center"/></Border>
   <TextBlock Text="Ví dụ \\KE-TOAN\Canon2900 hoặc \\192.168.1.20\Canon2900." Style="{StaticResource Label}" Margin="0,4,0,12"/>
   <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Tài khoản trên máy chủ in" Style="{StaticResource Label}"/><Border Tag="RoundedClip" CornerRadius="8" BorderBrush="#C7D5E5" BorderThickness="1" Background="White"><TextBox x:Name="Account" BorderThickness="0" Padding="10,8" MinHeight="36" VerticalContentAlignment="Center"/></Border></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Mật khẩu (để trống nếu đã lưu)" Style="{StaticResource Label}"/><Border Tag="RoundedClip" CornerRadius="8" BorderBrush="#C7D5E5" BorderThickness="1" Background="White"><PasswordBox x:Name="Password" BorderThickness="0" Padding="10,8" MinHeight="36" VerticalContentAlignment="Center"/></Border></StackPanel>
   </Grid>
   <TextBlock Text="Mật khẩu được thử trước rồi mới lưu vào Windows Credential Manager của tài khoản đang dùng máy; app không ghi mật khẩu ra file hay nhật ký." Style="{StaticResource Label}" Margin="0,0,0,12"/>
   <WrapPanel><CheckBox x:Name="ShareDefault" Margin="0,0,18,8"><TextBlock Text="Đặt làm máy in mặc định"/></CheckBox><CheckBox x:Name="ShareTestPage" Margin="0,0,0,8"><TextBlock Text="In trang thử"/></CheckBox></WrapPanel>
  </StackPanel></Border>
  <Border x:Name="DriverCard" Style="{StaticResource Card}"><StackPanel>
   <TextBlock Text="Driver" Style="{StaticResource Heading}"/>
   <TextBlock x:Name="DriverHint" Text="Chọn driver đã cài trên máy, hoặc chọn thư mục driver đã giải nén của hãng (kho USB / NAS): app cài bằng quyền Administrator, chỉ nhận driver có chữ ký." Style="{StaticResource Label}" Margin="0,0,0,10"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Tag="RoundedClip" CornerRadius="8" BorderBrush="#C7D5E5" BorderThickness="1" Background="White"><ComboBox x:Name="Driver" BorderThickness="0" DisplayMemberPath="Label"/></Border>
    <Button x:Name="PickDriverFolder" Grid.Column="2" Content="Chọn thư mục driver…" Background="#E7EEF8" Foreground="#183655"/>
   </Grid>
  </StackPanel></Border>
  <Border x:Name="RpcCard" Style="{StaticResource Card}"><StackPanel>
   <TextBlock Text="Chế độ tương thích RPC (khi vẫn lỗi 0x00000709 / 0x0000011b)" Style="{StaticResource Heading}"/>
   <TextBlock Text="Windows 11 22H2 trở lên kết nối máy chủ in qua RPC over TCP; máy chủ Windows 10 / bản cũ hoặc tường lửa chặn cổng 135 thì lỗi. Chế độ này chỉ đổi máy này sang RPC qua named pipes (vẫn xác thực và mã hoá), không tắt bản vá PrintNightmare, không đổi máy chủ. Có sao lưu và Hoàn tác." Style="{StaticResource Label}" Margin="0,0,0,10"/>
   <TextBlock x:Name="RpcState" Text="Đang đọc…" Margin="0,0,0,12"/>
   <WrapPanel><Button x:Name="RpcEnable" Content="Bật chế độ tương thích" Background="#E7EEF8" Foreground="#183655" Margin="0,0,8,0"/><Button x:Name="RpcUndo" Content="Hoàn tác" Background="#E7EEF8" Foreground="#183655"/></WrapPanel>
  </StackPanel></Border>
 </StackPanel>
 <TextBlock x:Name="Log" Foreground="#526880" FontSize="12"/>
</StackPanel></ScrollViewer>
<Border Grid.Row="2" Background="White" BorderBrush="#DFE7F1" BorderThickness="0,1,0,0" Padding="22,14"><WrapPanel HorizontalAlignment="Right"><Button x:Name="Diagnose" Content="Kiểm tra kết nối" Background="#E7EEF8" Foreground="#183655" Margin="0,0,8,8"/><Button x:Name="Apply" Content="Thêm máy in" Margin="0,0,8,8"/><Button x:Name="Close" Content="Đóng" Background="#E7EEF8" Foreground="#183655" Margin="0,0,0,8"/></WrapPanel></Border>
</Grid></Window>
