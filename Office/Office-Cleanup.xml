<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Gỡ / dọn Office" Width="960" Height="660" MinWidth="820" MinHeight="520" WindowStartupLocation="CenterScreen" Background="#F3F6FB" Foreground="#10223F" FontFamily="Segoe UI" FontSize="14">
<Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="0,0,10,8"/><Setter Property="Background" Value="#214674"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style></Window.Resources>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="#10223F" Padding="26,20"><StackPanel><TextBlock Text="Gỡ / dọn Office" FontSize="24" FontWeight="SemiBold" Foreground="White"/><TextBlock x:Name="Products" Foreground="#BED2E9" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
<Grid Grid.Row="1" Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Đánh dấu đúng key cần xoá. Key không chọn được giữ, gồm Retail. Công cụ không thể phục hồi key đầy đủ từ 5 ký tự cuối." TextWrapping="Wrap" Margin="0,0,0,16"/>
<DataGrid x:Name="Keys" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single"><DataGrid.Columns><DataGridTemplateColumn Header="Xoá" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Loại" Binding="{Binding Kind}" Width="140" IsReadOnly="True"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="130" IsReadOnly="True"/><DataGridTextColumn Header="Đuôi key" Binding="{Binding Last5}" Width="85" IsReadOnly="True"/><DataGridTextColumn Header="License" Binding="{Binding Name}" Width="*" IsReadOnly="True"/></DataGrid.Columns></DataGrid>
<ProgressBar x:Name="Progress" Grid.Row="2" Height="8" Margin="0,16,0,12"/><TextBlock x:Name="Status" Grid.Row="3" Text="Đang kiểm tra Office…" TextWrapping="Wrap"/>
</Grid><Border Grid.Row="2" Background="White" Padding="24,16"><WrapPanel><Button x:Name="Refresh" Content="Làm mới"/><Button x:Name="SelectTrial" Content="Chọn key dùng thử"/><Button x:Name="DeleteKeys" Content="Xoá key đã chọn" Background="#B91C1C"/><Button x:Name="RemoveOffice" Content="Gỡ Office 2021/2024…" Background="#B91C1C"/><Button x:Name="ViewLog" Content="Nhật ký"/><Button x:Name="Close" Content="Đóng"/></WrapPanel></Border></Grid></Window>
