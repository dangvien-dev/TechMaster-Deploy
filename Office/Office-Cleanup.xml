<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Gỡ / dọn Office" Width="960" Height="660" MinWidth="820" MinHeight="520" WindowStartupLocation="CenterScreen" Background="#F3F6FB" Foreground="#10223F" FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True">
<Window.Resources><Style TargetType="Button"><Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="0,0,10,8"/><Setter Property="Background" Value="#214674"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Style><Style x:Key="LicenseText" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="ToolTip" Value="{Binding Name}"/></Style><Style x:Key="KeyTail" TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="VerticalAlignment" Value="Center"/></Style></Window.Resources>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Background="#10223F" Padding="26,20"><StackPanel><TextBlock x:Name="Heading" Text="Gỡ / dọn Office" FontSize="24" FontWeight="SemiBold" Foreground="White"/><TextBlock x:Name="Products" Foreground="#BED2E9" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
<Grid Grid.Row="1" Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="Instructions" Text="Đánh dấu đúng key cần xoá. Key không chọn được giữ, gồm Retail. Công cụ không thể phục hồi key đầy đủ từ 5 ký tự cuối." TextWrapping="Wrap" Margin="0,0,0,16"/>
<Border CornerRadius="8" Tag="RoundedClip" Background="White" BorderBrush="#C7D5E5" BorderThickness="1" Grid.Row="1"><DataGrid x:Name="Keys" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single" Margin="0" BorderThickness="0"><DataGrid.Columns><DataGridTemplateColumn Header="Xoá" Width="64"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="22" MinHeight="22" ToolTip="Chọn key để xoá sau khi xác nhận" AutomationProperties.Name="Chọn key để xoá"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Loại key" Binding="{Binding Kind}" Width="144" IsReadOnly="True"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="148" IsReadOnly="True"/><DataGridTextColumn Header="5 ký tự cuối" Binding="{Binding Last5}" Width="120" ElementStyle="{StaticResource KeyTail}" IsReadOnly="True"/><DataGridTextColumn Header="Giấy phép Office" Binding="{Binding Name}" Width="*" MinWidth="200" ElementStyle="{StaticResource LicenseText}" IsReadOnly="True"/></DataGrid.Columns></DataGrid></Border>
<Border CornerRadius="4" Tag="RoundedClip" Background="White" BorderBrush="#C7D5E5" BorderThickness="0" Grid.Row="2" Margin="0,16,0,12" Height="8"><ProgressBar x:Name="Progress" Margin="0" BorderThickness="0"/></Border><TextBlock x:Name="Status" Grid.Row="3" Text="Đang kiểm tra Office…" TextWrapping="Wrap"/>
</Grid><Border Grid.Row="2" Background="White" Padding="24,16"><WrapPanel><Button x:Name="Refresh" Content="Làm mới"/><Button x:Name="SelectTrial" Content="Chọn key dùng thử"/><Button x:Name="DeleteKeys" Content="Xoá key đã chọn" Background="#B91C1C"/><Button x:Name="RemoveOffice" Content="Gỡ Office 2021/2024…" Background="#B91C1C"/><Button x:Name="ViewLog" Content="Nhật ký"/><Button x:Name="Close" Content="Đóng"/></WrapPanel></Border></Grid></Window>
